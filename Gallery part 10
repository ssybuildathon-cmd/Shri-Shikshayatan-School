function playBlinkTransition(onDone){
  const top = document.getElementById('blinkTop');
  const bot = document.getElementById('blinkBottom');
  let blinks = 0;
  function close(cb){
    top.style.transition = bot.style.transition = 'height 0.16s ease-in';
    top.style.height = bot.style.height = '52%';
    setTimeout(cb, 170);
  }
  function open(cb){
    top.style.transition = bot.style.transition = 'height 0.22s ease-out';
    top.style.height = bot.style.height = '0%';
    setTimeout(cb, 230);
  }
  function cycle(){
    blinks++;
    close(()=>{
      if(blinks >= 2){ onDone(); return; }
      setTimeout(()=> open(cycle), 90);
    });
  }
  cycle();
}


// ---- Intro cutscene: a four-shot first-person sequence — entering the
// museum, exploring it, noticing a painting, then the doppelganger reveal —
// followed by a color glitch and a double blink into the rules screen. ----
let introAC = null;
function introAudio(){
  if(!introAC){ try{ introAC = new (window.AudioContext||window.webkitAudioContext)(); }catch(e){} }
  return introAC;
}
function introTone(freq,dur,type,vol,delay){
  const ac = introAudio(); if(!ac) return;
  const t0 = ac.currentTime + (delay||0);
  const osc = ac.createOscillator(), g = ac.createGain();
  osc.type = type||'sine'; osc.frequency.setValueAtTime(freq, t0);
  g.gain.setValueAtTime(0.0001, t0);
  g.gain.exponentialRampToValueAtTime(vol||0.08, t0+0.05);
  g.gain.exponentialRampToValueAtTime(0.0001, t0+dur);
  osc.connect(g).connect(ac.destination);
  osc.start(t0); osc.stop(t0+dur+0.05);
}
function introNoise(dur,vol){
  const ac = introAudio(); if(!ac) return;
  const bufSize = ac.sampleRate*dur;
  const buf = ac.createBuffer(1, bufSize, ac.sampleRate);
  const data = buf.getChannelData(0);
  for(let i=0;i<bufSize;i++) data[i] = (Math.random()*2-1) * (1 - i/bufSize);
  const src = ac.createBufferSource(); src.buffer = buf;
  const g = ac.createGain(); g.gain.value = vol||0.1;
  src.connect(g).connect(ac.destination);
  src.start();
}
function introFootsteps(count){
  for(let i=0;i<count;i++) introTone(90+Math.random()*30, 0.09, 'square', 0.03, i*0.32);
}

const introShots = [
  { caption:"You slip in through the side door after closing hours. The gallery breathes around you — old wood, old dust, a held silence.",
    onEnter:()=>{ introFootsteps(3); introTone(60,1.4,'sine',0.02,0.1); } },
  { caption:"You wander the empty halls, half-listening to your own footsteps echo off the marble.",
    onEnter:()=>{ introFootsteps(4); } },
  { caption:"One painting stops you. A figure, alone, in a room with this floor. This ceiling. This exact angle of shadow.",
    onEnter:()=>{ introTone(220,1.8,'triangle',0.05,0.1); frameReveal(false); } },
  { caption:"You look down at your own feet, then back at the frame. The figure in the painting hasn't moved. It's standing where you're standing.",
    onEnter:()=>{ introTone(140,2.2,'sawtooth',0.045,0.1); introNoise(1.4,0.02); frameReveal(true); } },
];

function frameReveal(zoom){
  const frame = document.getElementById('introFrame');
  frame.style.opacity = 1;
  frame.classList.toggle('zoomed', !!zoom);
}

function runIntro(){
  const btn = document.getElementById('introContinue');
  let i = 0;

  function showShot(){
    document.querySelectorAll('.introShot').forEach((el,idx)=>{
      el.classList.toggle('active', idx===i);
    });
    document.getElementById('cap'+(i+1)).textContent = introShots[i].caption;
    if(i<2) document.getElementById('introFrame').style.opacity = 0;
    if(introShots[i].onEnter) introShots[i].onEnter();
    btn.style.display = 'inline-block';
    btn.textContent = (i === introShots.length - 1) ? "..." : "CONTINUE";
  }

  btn.onclick = ()=>{
    i++;
    if(i < introShots.length){
      showShot();
    } else {
      glitchOut();
    }
  };

  function glitchOut(){
    btn.style.display = 'none';
    introNoise(0.6,0.09);
    const flash = document.getElementById('introGlitchOverlay');
    flash.classList.add('colorGlitch');
    let flickers = 0;
    const flickerId = setInterval(()=>{
      flash.style.opacity = (flickers % 2 === 0) ? '0.9' : '0';
      flickers++;
      if(flickers > 7){
        clearInterval(flickerId);
        flash.style.opacity = '1';
        setTimeout(()=>{
          document.getElementById('introScene').style.display = 'none';
          flash.classList.remove('colorGlitch');
          flash.style.opacity = '0';
          // Double blink into the title & rules screen.
          playBlinkTransition(()=>{
            document.getElementById('startScreen').style.display = 'flex';
            document.getElementById('blinkTop').style.height = '0%';
            document.getElementById('blinkBottom').style.height = '0%';
          });
        }, 260);
      }
    }, 90);
  }

  showShot();
}

runIntro();
animate();
