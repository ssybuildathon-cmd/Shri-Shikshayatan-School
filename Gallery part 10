//// ---- Station 3: Number Lock (6-7 numbered dials, arrange in order; new numbers every attempt) ----
function generateNumberLockPuzzle(){
  const count = Math.random() < 0.5 ? 6 : 7;
  const pool = new Set();
  while(pool.size < count){
    pool.add(Math.floor(Math.random()*90) + 10); // two-digit dials, 10-99
  }
  const numbers = Array.from(pool);
  const ascending = Math.random() < 0.5;
  const correctOrder = numbers.slice().sort((a,b)=> ascending ? a-b : b-a);
  const displayed = numbers.slice().sort(()=>Math.random()-0.5);
  return {displayed, correctOrder, ascending};
}

