function updateBeacons(t){
  beacons.forEach(b=>{
    const solved = GameState.stationsSolved[b.stationName];
    const bob = Math.sin(t*0.0025 + b.baseY) * 0.06;
    b.group.position.y = b.baseY + bob;
    b.core.rotation.y += 0.02;
    const dim = solved ? 0.35 : 1;
    b.core.material.emissiveIntensity = (1.3 + Math.sin(t*0.004)*0.4) * dim;
    b.light.intensity = (0.55 + Math.sin(t*0.004)*0.2) * dim;
    b.core.material.opacity = solved ? 0.45 : 0.9;
  });
}

