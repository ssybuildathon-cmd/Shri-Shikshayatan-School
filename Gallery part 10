function updateFlashlight(){
  if(!flashlightLight || !GameState.tools.includes("UV Flashlight")) return;
  if(flashlightActive){
    flashlightLight.position.copy(camera.position);
    const forward = new THREE.Vector3(Math.sin(yaw), -0.3, Math.cos(yaw)).multiplyScalar(-1).normalize();
    flashlightLight.target.position.copy(camera.position).addScaledVector(forward, 15);
  }
}

// Initialize flashlight when scene loads
initFlashlight();
let currentTarget = null;
function resolveInteractiveTarget(object){
  let node = object;
  while(node){
    if(node.userData && node.userData.interactive && node.userData.interactionId){
      return interactables.find(i=>i.interactionId === node.userData.interactionId) || null;
    }
    node = node.parent;
  }
  return null;
}
// The first solid scene hit must be the same exhibit hit by the interaction ray.
// This prevents activation through walls, furniture, floors, or another exhibit.
function hasClearLineOfSight(targetHit){
  const allHits = raycaster.intersectObjects(scene.children, true);
  const first = allHits.find(h=>h.object.visible && h.object.type === 'Mesh' && h.object !== motes);
  if(!first) return false;
  const firstTarget = resolveInteractiveTarget(first.object);
  // A direct hit on the intended exhibit is clear. Only another solid
  // interactive exhibit in front of it blocks the interaction.
  return !firstTarget || firstTarget.interactionId === targetHit.interactionId;
}
const interactiveObjects = [];
function refreshInteractiveRoots(){
  interactiveObjects.length=0;
  interactables.forEach(i=>interactiveObjects.push(i.collider || i.mesh));
}
const interactionWorldPos = new THREE.Vector3();
function updateInteractionTarget(){
  const promptEl = document.getElementById('prompt');
  let nearest = null;
  let nearestDistance = Infinity;

  // Interaction is based on horizontal proximity, not exact crosshair
  // alignment. Use the registered collider/root's world position so nested
  // Groups are handled correctly.
  for(const st of interactables){
    const root = st && (st.collider || st.mesh);
    if(!root || !root.parent || typeof root.getWorldPosition !== 'function') continue;
    root.getWorldPosition(interactionWorldPos);
    const dx = playerPos.x - interactionWorldPos.x;
    const dz = playerPos.z - interactionWorldPos.z;
    const distance = Math.sqrt(dx * dx + dz * dz);
    if(distance <= st.interactionDistance && distance < nearestDistance){
      nearest = st;
      nearestDistance = distance;
    }
  }

  if(nearest){
    currentTarget = nearest;
    promptEl.textContent = nearest.promptText;
    promptEl.style.display = 'block';
    setHighlight(nearest.mesh);
  } else {
    currentTarget = null;
    promptEl.style.display = 'none';
    setHighlight(null);
  }
}
function tryInteract(){
  if(GameState.ended) return;
  if(document.getElementById('modalOverlay').style.display === 'flex') return;
  if(currentTarget){
    currentTarget.onInteract();
  }
}
// Single click handler: if the mouse isn't captured yet, capture it; if it
// already is and something's in the crosshair, interact with it. (Previously
// two separate click listeners did this, which worked but fired redundantly
// on every click — merged into one for clarity and to avoid any chance of
// double-triggering an interaction.)
canvas.addEventListener('click', ()=>{
  if(GameState.ended || document.getElementById('modalOverlay').style.display === 'flex') return;
  if(!GameState.pointerLocked){
    requestPointerLock();
  } else if(currentTarget){
    tryInteract();
  }
});

//// ---------- MOVEMENT ----------
// (Per-object colliders were built but never actually blocked movement —
// checkCollision() unconditionally returned false — so the whole array of
// invisible boxes was dead weight. Removed; the room-boundary clamp below
// is the only collision the game ever used.)
const clock3 = new THREE.Clock();
function updateMovement(delta){
  if(!GameState.pointerLocked) return;
  const speed = 3.4 * delta;
  const forward = new THREE.Vector3(Math.sin(yaw), 0, Math.cos(yaw)).multiplyScalar(-1);
  const right = new THREE.Vector3(forward.z, 0, -forward.x);

  let move = new THREE.Vector3();
  if(keys['KeyW']) move.add(forward);
  if(keys['KeyS']) move.sub(forward);
  if(keys['KeyA']) move.sub(right);
  if(keys['KeyD']) move.add(right);
  if(move.lengthSq() > 0){
    move.normalize().multiplyScalar(speed);
    const newPos = playerPos.clone().add(move);

    // Clamp to room boundaries — the only collision the game needs
    newPos.x = Math.max(-ROOM_HALF_X+0.6, Math.min(ROOM_HALF_X-0.6, newPos.x));
    newPos.z = Math.max(-ROOM_HALF_Z+0.6, Math.min(ROOM_HALF_Z-0.6, newPos.z));

    playerPos.copy(newPos);
  }
  camera.position.copy(playerPos);
  camera.rotation.set(pitch, yaw, 0, 'YXZ');
}

