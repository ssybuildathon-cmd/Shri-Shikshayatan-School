// These make it obvious, even to a first-time player, exactly which objects
// in the room can be interacted with. They pulse gently and dim once a
// station has been solved (except the always-active Vault and Mummy).
const beacons = [];
function addBeacon(group, height, name){
  const beaconGroup = new THREE.Group();
  const core = new THREE.Mesh(
    new THREE.OctahedronGeometry(0.14, 0),
    new THREE.MeshStandardMaterial({color:0xffdca8, emissive:0xffbb55, emissiveIntensity:1.6, transparent:true, opacity:0.9})
  );
  const beam = new THREE.Mesh(
    new THREE.CylinderGeometry(0.02,0.05,0.9,8,1,true),
    new THREE.MeshBasicMaterial({color:0xffcf8a, transparent:true, opacity:0.25, side:THREE.DoubleSide})
  );
  beam.position.y = -0.5;
  const light = new THREE.PointLight(0xffcf8a, 0.6, 3.5, 2);
  beaconGroup.add(core, beam, light);
  beaconGroup.position.set(group.position.x, height, group.position.z);
  scene.add(beaconGroup);
  beacons.push({group: beaconGroup, core, light, stationName: name, baseY: height});
}
