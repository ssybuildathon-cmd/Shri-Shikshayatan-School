//// ---- Station 2: Cabinet (BODMAS gem cipher — new equations every attempt) ----
// Builds four color->equation pairs: three reduce to distinct whole numbers,
// one (the forgery) deliberately leaves a remainder. Regenerated fresh each
// time the puzzle window is opened, so a retry never shows the same sums.
function generateCabinetPuzzle(){
  function ri(min,max){ return Math.floor(Math.random()*(max-min+1))+min; }
  function wholeEq(){
    const kind = ri(0,3);
    if(kind===0){ const a=ri(1,9), b=ri(2,9), c=ri(2,9); return {text:`${a} + ${b} × ${c}`, value:a+b*c}; }
    if(kind===1){ const a=ri(2,9), b=ri(2,9), c=ri(1,20); return {text:`${a} × ${b} − ${c}`, value:a*b-c}; }
    if(kind===2){ const divisor=ri(2,6), mult=ri(2,9), a=divisor*mult, c=ri(1,12); return {text:`${a} ÷ ${divisor} + ${c}`, value:mult+c}; }
    const divisor=ri(2,6), mult=ri(2,9), a=divisor*mult, c=ri(1,12); return {text:`${c} + ${a} ÷ ${divisor}`, value:c+mult};
  }
  function forgeryEq(){
    let divisor, a;
    do{ divisor=ri(2,9); a=ri(1,40); }while(a % divisor === 0);
    const c = ri(1,9);
    const value = Math.round((a/divisor + c)*100)/100;
    return {text:`${a} ÷ ${divisor} + ${c}`, value};
  }
  const seen = new Set();
  const genuine = [];
  let guard = 0;
  while(genuine.length<3 && guard<300){
    guard++;
    const eq = wholeEq();
    if(Number.isInteger(eq.value) && !seen.has(eq.value)){
      seen.add(eq.value);
      genuine.push(eq);
    }
  }
  const forgery = forgeryEq();
  const colors = ["Red","Blue","Green","Yellow"];
  const shuffled = colors.slice().sort(()=>Math.random()-0.5);
  const eqs = {};
  eqs[shuffled[0]] = genuine[0];
  eqs[shuffled[1]] = genuine[1];
  eqs[shuffled[2]] = genuine[2];
  eqs[shuffled[3]] = forgery;
  const forgeryColor = shuffled[3];
  const genuineColors = [shuffled[0],shuffled[1],shuffled[2]];
  const order = genuineColors.slice().sort((x,y)=> eqs[x].value - eqs[y].value);
  return {eqs, forgeryColor, order};
}

