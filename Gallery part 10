//// ---- Station 5: Portrait (assemble fragments + major glitch chase-in-room) ----
//// ---- Bonus Station: Portrait (picture-matching puzzle — locked until the Dial Key) ----
function generatePortraitPuzzle(){
  const POOL = [
    {name:"Sunlit Courtyard", emoji:"☀️"},
    {name:"Grand Staircase", emoji:"🪜"},
    {name:"Harbor at Dusk", emoji:"⚓"},
    {name:"West Wing Corridor", emoji:"🚪"},
    {name:"Autumn Garden", emoji:"🍂"},
    {name:"Moonlit Lake", emoji:"🌙"},
    {name:"Mountain Pass", emoji:"⛰️"}
  ];
  const shuffled = POOL.slice().sort(()=>Math.random()-0.5);
  const options = shuffled.slice(0,4);
  const correct = options[Math.floor(Math.random()*options.length)];
  return {options, correct};
}

function openPuzzle_Portrait(){
  if(GameState.stationsSolved["The Portrait"]){
    openModal("The Portrait", "The row of paintings is complete now — nothing left to hang.", [{label:"Close", action:closeModal}]);
    return;
  }
  if(stationLocked("The Portrait")){
    openModal("The Portrait", lockedMessage("The Portrait"), [{label:"Close", action:closeModal}]);
    return;
  }
  const puzzle = generatePortraitPuzzle();
  let hintShown = false;
  function render(){
    modalBody.innerHTML =
      "A row of framed paintings lines the wall, with one empty spot. Carved faintly into the bare wood of that empty frame is a small picture of what's supposed to hang there:<br><br>" +
      `<div style="text-align:center;font-size:52px;margin:10px 0;">${puzzle.correct.emoji}</div>` +
      `<div style="text-align:center;color:#b8a06a;font-style:italic;margin-bottom:6px;">That's the picture carved into the empty frame.</div>` +
      "<b>Click the painting below whose picture matches it.</b>" +
      (hintShown ? `<br><br><b style="color:#e8c873">Hint:</b> You're looking for ${puzzle.correct.emoji} — that's "${puzzle.correct.name}".` : "");
    modalBtns.innerHTML = "";
    puzzle.options.forEach(opt=>{
      const btn = document.createElement('button');
      btn.className = 'choiceBtn';
      btn.style.display = 'inline-flex';
      btn.style.flexDirection = 'column';
      btn.style.alignItems = 'center';
      btn.style.gap = '4px';
      btn.style.minWidth = '92px';
      btn.innerHTML = `<span style="font-size:30px;line-height:1;">${opt.emoji}</span><span style="font-size:11px;">${opt.name}</span>`;
      btn.onclick = ()=>{
        if(opt.name === puzzle.correct.name){
          closeModal();
          logMsg("The canvas settles into the frame — a perfect fit. Something about it feels wrong a second later.");
          startPortraitGlitch();
        } else {
          puzzleFail("Wrong canvas — the room goes silent, then the air snaps back with a low, oppressive hum.");
          closeModal();
        }
      };
      modalBtns.appendChild(btn);
    });
    const hintBtn = document.createElement('button');
    hintBtn.className = 'choiceBtn';
    hintBtn.textContent = "💡 Need a hint?";
    hintBtn.onclick = ()=>{ hintShown = true; render(); };
    modalBtns.appendChild(hintBtn);
  }
  modalTitle.textContent = "The Portrait";
  overlay.style.display = 'flex';
  exitPointerLock();
  render();
}

function startPortraitGlitch(){
  logMsg("The portrait's eyes move. Then the frame is empty.", true);
  if(typeof portraitEyes !== 'undefined') portraitEyes.forEach(eye=>{ eye.visible=true; eye.material.emissiveIntensity=3.4; });
  if(typeof portraitEyeGlow !== 'undefined'){ portraitEyeGlow.visible=true; portraitEyeGlow.intensity=1.1; }
  figureGroup.visible = true;
  figureGroup.position.set(-2.2, 1.1, -9.3);
  document.getElementById('vignette').classList.add('danger');
  GameState.glitchActive = true;
  const banner = document.getElementById('glitchBanner');
  banner.textContent = "Get ready... it's about to move";
  banner.style.display = 'block';
  requestPointerLock(); // regain mouse-look + movement immediately so the player can actually run

  const coverPoints = [
    new THREE.Vector3(-11, 1.1, -8),
    new THREE.Vector3(11, 1.1, -8.6),
    new THREE.Vector3(13.6, 1.1, 2),
    new THREE.Vector3(-13.6, 1.1, 3.5),
    new THREE.Vector3(-10.5, 1.1, 7),
  ];
  const graceMs = 1400; // time for the player to reorient before it starts advancing/judging
  const duration = 9000;
  const start = performance.now();
  let seenTime = 0;

  function tick(){
    if(GameState.ended){
      figureGroup.visible = false;
      banner.style.display = 'none';
      GameState.glitchActive = false;
      return;
    }
    const elapsed = performance.now() - start;
    const t = elapsed - graceMs;
    if(elapsed < graceMs){
      banner.textContent = "Get ready — find cover behind another exhibit";
      requestAnimationFrame(tick);
      return;
    }
    if(t === 0 || (t>0 && t<20)){ banner.textContent = "Run to the Desk, Cabinet, Armor, or Clock — stand close to break line of sight"; }
    if(t > duration || GameState.ended){
      figureGroup.visible = false;
      banner.style.display = 'none';
      document.getElementById('vignette').classList.toggle('danger', GameState.lightsCut);
      GameState.glitchActive = false;
      if(seenTime > 2000){
        logMsg("It reached you.", true);
        loseLife();
        doTimeSkip("the figure closed in.");
      } else {
        logMsg("You broke its line of sight long enough. It withdraws into the frame.");
        GameState.composureBoosts++;
        steadyHands = true;
        GameState.stationsSolved["The Portrait"] = true;
        logMsg("Composure boost earned: Steady Hands active for your next mistake.");
        GameState.lore.push("Full Vision");
      }
      updateHUD();
      return;
    }
    // figure slowly advances toward player unless the player has a wall/station between them (approx via distance to nearest cover point acting as a break-LOS proxy)
    const toPlayer = playerPos.clone().sub(figureGroup.position);
    const dist = toPlayer.length();
    let nearCover = coverPoints.some(cp => playerPos.distanceTo(cp) < 2.0);

    const camDir = new THREE.Vector3();
    camera.getWorldDirection(camDir);
    const toFigure = figureGroup.position.clone().sub(camera.position).normalize();
    const facingIt = camDir.dot(toFigure) > 0.4;

    if(!nearCover && dist > 0.9){
      figureGroup.position.addScaledVector(toPlayer.normalize(), 0.009 * (facingIt?0.4:1)); // advances faster if you're NOT looking (classic "don't look away" inversion could be tuned)
    }
    if(facingIt && dist < 6){ seenTime += 16; }
    if(dist < 1.0){
      figureGroup.visible = false;
      banner.style.display = 'none';
      document.getElementById('vignette').classList.toggle('danger', GameState.lightsCut);
      GameState.glitchActive = false;
      logMsg("It reached you.", true);
      loseLife();
      doTimeSkip("caught in the open.");
      updateHUD();
      return;
    }
    requestAnimationFrame(tick);
  }
  tick();
}

