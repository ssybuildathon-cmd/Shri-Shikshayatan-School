//// ---------- PRESENTATION SYSTEMS (gameplay-independent) ----------
let museumAudio = null;
function initMuseumAudio(){
  if(museumAudio || !window.AudioContext && !window.webkitAudioContext) return;
  const AC=window.AudioContext||window.webkitAudioContext; const ac=new AC();
  const master=ac.createGain(); master.gain.value=.018; master.connect(ac.destination);
  const hum=ac.createOscillator(); const humGain=ac.createGain(); hum.type='sine'; hum.frequency.value=52; humGain.gain.value=.22; hum.connect(humGain).connect(master); hum.start();
  const air=ac.createOscillator(); const airGain=ac.createGain(); air.type='triangle'; air.frequency.value=118; airGain.gain.value=.035; air.connect(airGain).connect(master); air.start();
  museumAudio={ac,master,humGain,airGain};
}
function updateTimeAtmosphere(){
  const p=Math.min(1,GameState.skipCount/6);
  // Existing six skips drive only visual temperature, fog, and ambience.
  const warm=new THREE.Color(0x4a4130), late=new THREE.Color(0x292d3b);
  ambient.color.copy(warm).lerp(late,p*.65);
  ambient.intensity=(GameState.lightsCut ? .06 : .28)*(1-p*.12);
  scene.fog.density=.017 + p*.006;
  if(museumAudio) museumAudio.master.gain.value=.018 + p*.006;
}
let debugEnabled=false, debugLast=0;
function updateDebug(now, delta){
  if(!debugEnabled || now-debugLast<250) return; debugLast=now;
  const panel=document.getElementById('debugPanel');
  panel.textContent=`DEBUG F3 | QUALITY ${GALLERY_QUALITY}\nFPS target: ${Math.round(1/Math.max(delta,.001))}\nDraw calls: ${renderer.info.render.calls}\nTriangles: ${renderer.info.render.triangles}\nObjects: ${scene.children.length}\nInteractive roots: ${interactables.length}\nTarget: ${currentTarget?currentTarget.name:'none'}\nRange: ${currentTarget?currentTarget.interactionDistance:'—'}`;
}
document.addEventListener('keydown',e=>{ if(e.code==='F3'){ debugEnabled=!debugEnabled; document.getElementById('debugPanel').style.display=debugEnabled?'block':'none'; } });

//// ---------- MAIN LOOP ----------
function animate(){
  if(GameState.ended){ renderer.render(scene, camera); requestAnimationFrame(animate); return; }
  const delta = Math.min(clock3.getDelta(), 0.1);
  updateMovement(delta);
  const moving = keys['KeyW']||keys['KeyS']||keys['KeyA']||keys['KeyD'];
  const bob = moving && GameState.pointerLocked ? Math.sin(performance.now()*.010)*.012 : 0;
  camera.position.y = playerPos.y + bob;
  updateInteractionTarget();
  const now = performance.now();
  updateBeacons(now);
  updateCinematicLighting(now);
  updateTimeAtmosphere();
  updateFlashlight();
  if(clockPendulum && !GameState.ended) clockPendulum.rotation.z = Math.sin(now*0.0018)*0.09;

  // Animate figure's menacing hands when active
  if(GameState.glitchActive && figureGroup.userData.arms){
    const time = performance.now() * 0.003;
    figureGroup.userData.arms.forEach(arm => {
      const hand = arm.userData.hand;
      const side = arm.userData.side;
      // Make hands reach forward and backward menacingly
      hand.position.y = hand.userData.baseY + Math.sin(time + side)*0.15 + Math.cos(time*1.5)*0.08;
      hand.position.z = Math.sin(time*1.2 + side)*0.2 + Math.cos(time)*0.15;
      // Rotate hands in threatening way
      hand.rotation.x = Math.sin(time + side*0.5)*0.4;
      hand.rotation.z = side * (Math.sin(time*0.8)*0.3 + 0.3);
      // Slight twitch motions
      hand.rotation.y = Math.sin(time*2.1)*0.15;
    });
  }

  // drift dust motes upward, loop back to floor
  const moteAttr = moteGeo.attributes.position;
  for(let mi2=0; mi2<MOTE_COUNT; mi2++){
    let yv = moteAttr.array[mi2*3+1] + moteSpeed[mi2]*delta;
    if(yv>ROOM_H-0.3) yv = 0;
    moteAttr.array[mi2*3+1] = yv;
    moteAttr.array[mi2*3] += Math.sin(performance.now()*0.0002+mi2)*0.0006;
  }
  moteAttr.needsUpdate = true;
  if(cinematicLights.length) moteMat.opacity = 0.28 + Math.min(0.22, cinematicLights.reduce((sum,x)=>sum+x.light.intensity,0)*0.006);
  updateDebug(now, delta);

  renderer.render(scene, camera);
  requestAnimationFrame(animate);
}

