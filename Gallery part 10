function triggerArmorGlitch(willSolve){
  GameState.glitchActive = true;
  logMsg("The helm turns. Slowly. Look away.", true);
  document.getElementById('vignette').classList.add('danger');
  const banner = document.getElementById('glitchBanner');
  banner.textContent = "Get ready... you're about to need to look away";
  banner.style.display = 'block';
  requestPointerLock(); // regain mouse-look immediately so the player can actually turn away

  // simple QTE: player must NOT look at the armor for ~2.5s (camera direction check).
  // A short grace period runs first (doesn't count against the player) so there's
  // always real time to move the mouse before judging begins.
  let watchedTooLong = 0;
  const armorWorldPos = new THREE.Vector3();
  torso.getWorldPosition(armorWorldPos);
  const graceMs = 1300;
  const qteDuration = 2600;
  const start = performance.now();

  function qteTick(){
    // Bail out cleanly if the game ended by some other means (e.g. time ran
    // out) while this loop was still ticking — otherwise it keeps running in
    // the background and can still hand out a fragment after the end screen.
    if(GameState.ended){
      GameState.glitchActive = false;
      banner.style.display = 'none';
      return;
    }
    const elapsed = performance.now() - start;
    if(elapsed < graceMs){
      banner.textContent = "Get ready... look away from the armor now";
      requestAnimationFrame(qteTick);
      return;
    }
    if(elapsed - graceMs < 20){ banner.textContent = "Don't look at the armor — hold on!"; }
    if(elapsed > graceMs + qteDuration){
      GameState.glitchActive = false;
      banner.style.display = 'none';
      document.getElementById('vignette').classList.toggle('danger', GameState.lightsCut);
      if(watchedTooLong > 1100){
        logMsg("It noticed you.", true);
        doTimeSkip("the armor noticed you watching.");
      } else {
        logMsg("You kept your eyes down. It settles.");
        GameState.composureBoosts++;
        steadyHands = true;
        logMsg("Composure boost earned: Steady Hands active for your next mistake.");
      }
      if(willSolve){
        GameState.stationsSolved["Number Lock"] = true;
        collectTool("Dial Key");
        logMsg("The dials click into place and the chestplate springs open. You take the Dial Key.");
        updateHUD();
      }
      return;
    }
    // check if camera is roughly facing the armor
    const camDir = new THREE.Vector3();
    camera.getWorldDirection(camDir);
    const toArmor = armorWorldPos.clone().sub(camera.position).normalize();
    const dot = camDir.dot(toArmor);
    if(dot > 0.75){ watchedTooLong += 16; }
    requestAnimationFrame(qteTick);
  }
  qteTick();
}

