  // Small standing sarcophagus replica (ambient prop, echoing the reference photos)
  function makeSarcoStatue(){
    const g = new THREE.Group();
    const plinth = new THREE.Mesh(new THREE.CylinderGeometry(0.26,0.3,0.14,16), bronzeDark);
    plinth.position.y = 0.07;
    const body = new THREE.Mesh(new THREE.BoxGeometry(0.34,0.95,0.22), bronze);
    body.position.y = 0.62;
    const face = new THREE.Mesh(new THREE.BoxGeometry(0.24,0.22,0.06), gold);
    face.position.set(0, 1.0, 0.14);
    const trim1 = new THREE.Mesh(new THREE.BoxGeometry(0.36,0.04,0.24), gold);
    trim1.position.y = 0.85;
    const trim2 = trim1.clone(); trim2.position.y = 0.45;
    g.add(plinth, body, face, trim1, trim2);
