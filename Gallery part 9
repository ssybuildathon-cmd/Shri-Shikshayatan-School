function registerStation(mesh, name, promptText, onInteract, extraCollider=null){
  const interactionId = name;
  const interactionDistance = ({
    "The Portrait":2.7, "Number Lock":2.8, "Grandfather Clock":3.0,
    "Curator's Desk":2.9, "Display Cabinet":3.0, "The Vault":3.1, "The Mummy":3.0
  })[name] || 2.8;
  mesh.userData.interactable = true;
  mesh.userData.interactionId = interactionId;
  mesh.userData.stationName = name;
  const root = extraCollider || mesh;
  root.userData.interactable = true;
  root.userData.interactionId = interactionId;
  root.userData.stationName = name;
  interactables.push({mesh, name, promptText, onInteract, collider: root, interactionId, interactionDistance});
}

