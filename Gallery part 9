  // Small bronze wrapped-mummy statue (ambient prop, not the interactive Mummy station)
  function makeMummyStatue(){
    const g = new THREE.Group();
    const plinth = new THREE.Mesh(new THREE.BoxGeometry(0.4,0.12,0.4), bronzeDark);
    plinth.position.y = 0.06;
    const body = new THREE.Mesh(new THREE.CylinderGeometry(0.1,0.14,0.75,14), bronze);
    body.position.y = 0.5;
    const head = new THREE.Mesh(new THREE.SphereGeometry(0.09,14,14), bronze);
    head.position.y = 0.95;
    // a slightly out-stretched arm, echoing the reference photo's pose
    const arm = new THREE.Mesh(new THREE.CylinderGeometry(0.03,0.035,0.32,8), bronze);
    arm.position.set(0.14,0.62,0.04);
    arm.rotation.z = -0.9;
