  }
  const sarco1 = makeSarcoStatue();
  sarco1.position.set(-2.6, 0, 8.9);
  sarco1.rotation.y = 0.5;
  scene.add(sarco1);

  const sarco2 = makeSarcoStatue();
  sarco2.position.set(9.5, 0, -2);
  sarco2.rotation.y = -1.1;
  scene.add(sarco2);

  // Small antique wall clock, mounted flush on the east wall (decorative only,
  // distinct from the interactive Grandfather Clock station on the west wall)
  function makeWallClock(){
    const g = new THREE.Group();
    const rim = new THREE.Mesh(new THREE.CylinderGeometry(0.32,0.32,0.06,20), gold);
    rim.rotation.x = Math.PI/2;
    const clockFaceTexLoader = new THREE.TextureLoader();
    const clockFaceMap = clockFaceTexLoader.load(REAL_ASSETS.clockFace);
    clockFaceMap.colorSpace = THREE.SRGBColorSpace;
    const clockFaceNormalMap = clockFaceTexLoader.load(REAL_ASSETS.clockFaceNormal);
    const face = new THREE.Mesh(new THREE.CircleGeometry(0.27,32),
      new THREE.MeshStandardMaterial({map:clockFaceMap, normalMap:clockFaceNormalMap, roughness:0.75}));
    face.position.z = 0.035;
    const hourHand = new THREE.Mesh(new THREE.BoxGeometry(0.025,0.14,0.008), new THREE.MeshStandardMaterial({color:0x111111}));
    hourHand.position.set(0,0.02,0.04);
    const minuteHand = new THREE.Mesh(new THREE.BoxGeometry(0.018,0.2,0.008), new THREE.MeshStandardMaterial({color:0x111111}));
    minuteHand.position.set(0,0.03,0.045);
    g.add(rim, face, hourHand, minuteHand);
    return g;
  }
  const wallClock = makeWallClock();
  wallClock.position.set(15.13, 2.6, -1.5);
  wallClock.rotation.y = -Math.PI/2;
  scene.add(wallClock);

  // ---- Brass vase, built from the real vase asset's PBR textures ----
  // Real .blend mesh geometry can't be parsed here (no Blender available),
  // so the actual sculpted mesh is approximated with a lathe silhouette and
  // dressed in the genuine diffuse/normal/roughness/metalness maps pulled
  // from the uploaded asset, wrapped once around like the original UV unwrap.
  function makeBrassVase(){
    const texLoader = new THREE.TextureLoader();
    const map = texLoader.load(REAL_ASSETS.vaseBody);
    map.colorSpace = THREE.SRGBColorSpace;
    const normalMap = texLoader.load(REAL_ASSETS.vaseBodyNormal);
    const roughnessMap = texLoader.load(REAL_ASSETS.vaseBodyRough);
    const metalnessMap = texLoader.load(REAL_ASSETS.vaseBodyMetal);
    [map, normalMap, roughnessMap, metalnessMap].forEach(t=>{ t.wrapS = THREE.ClampToEdgeWrapping; t.wrapT = THREE.ClampToEdgeWrapping; });
    const vaseMat = new THREE.MeshStandardMaterial({
      map, normalMap, roughnessMap, metalnessMap,
      metalness:1, roughness:1, envMapIntensity:1.4
    });
    // Profile points (radius, height) tracing a classic urn silhouette
    const profile = [
      [0.00,0.00],[0.22,0.00],[0.26,0.03],[0.24,0.10],[0.30,0.22],
      [0.34,0.38],[0.30,0.55],[0.22,0.66],[0.16,0.72],[0.20,0.78],
      [0.14,0.82],[0.00,0.84]
    ].map(([r,y])=> new THREE.Vector2(r*0.62, y*0.9));
    const body = new THREE.Mesh(new THREE.LatheGeometry(profile, 32), vaseMat);
    body.castShadow = true;
    const g = new THREE.Group();
    g.add(body);
    return g;
  }
  const vaseGroup = new THREE.Group();
  const brassVase = makeBrassVase();
  const vasePedestal = makePedestal(0.32);
  vasePedestal.position.y = 0.275;
  brassVase.position.y = 0.55;
  const vasePlacard = makePlacard("BRASS VASE, 4TH C.", "Ceremonial urn, hammered brass");
  vasePlacard.position.set(0.55, 0, 0.35);
  vasePlacard.rotation.y = -0.6;
  vaseGroup.add(vasePedestal, brassVase, vasePlacard);
  vaseGroup.position.set(-6.5, 0, -1.5);
  scene.add(vaseGroup);

  // ---- Marble bust, dressed in the real marble asset's PBR textures ----
  // Same caveat as the vase: the sculpted geometry itself isn't recoverable
  // without Blender, so a classical bust-on-plinth silhouette carries the
  // genuine marble color/roughness/normal maps from the uploaded asset.
  function makeMarbleBust(){
    const texLoader = new THREE.TextureLoader();
    const map = texLoader.load(REAL_ASSETS.marblePatch);
    map.colorSpace = THREE.SRGBColorSpace;
    const normalMap = texLoader.load(REAL_ASSETS.marblePatchNormal);
    const roughnessMap = texLoader.load(REAL_ASSETS.marblePatchRough);
    [map, normalMap, roughnessMap].forEach(t=>{ t.wrapS = t.wrapT = THREE.RepeatWrapping; t.repeat.set(1.6,1.6); });
    const marbleMat = new THREE.MeshStandardMaterial({map, normalMap, roughnessMap, metalness:0, envMapIntensity:0.6});
    const g = new THREE.Group();
    const plinth = new THREE.Mesh(new THREE.CylinderGeometry(0.22,0.26,0.5,20), marbleMat);
    plinth.position.y = 0.25;
    const shoulders = new THREE.Mesh(new THREE.CylinderGeometry(0.19,0.24,0.34,20), marbleMat);
    shoulders.position.y = 0.67;
    const neck = new THREE.Mesh(new THREE.CylinderGeometry(0.09,0.11,0.12,16), marbleMat);
    neck.position.y = 0.9;
    const head = new THREE.Mesh(new THREE.SphereGeometry(0.145,20,20), marbleMat);
    head.scale.set(1,1.2,0.95);
