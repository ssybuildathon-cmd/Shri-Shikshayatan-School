// Small grounded museum placard — like a real exhibit label on a stand,
// mounted low near the base of each piece instead of floating in mid-air.
function makePlacard(line1, line2){
  const cv = document.createElement('canvas');
  cv.width = 320; cv.height = 130;
  const ctx = cv.getContext('2d');
  ctx.fillStyle = "#171009";
  ctx.fillRect(0,0,320,130);
  ctx.strokeStyle = "#8a7345";
  ctx.lineWidth = 5;
  ctx.strokeRect(5,5,310,120);
  ctx.textAlign = "center";
  ctx.fillStyle = "#d3ad55";
  ctx.font = "bold 20px Georgia";
  ctx.fillText(line1, 160, 55);
  ctx.fillStyle = "#b8a06a";
  ctx.font = "italic 15px Georgia";
  ctx.fillText(line2, 160, 85);
  const tex = new THREE.CanvasTexture(cv);
  const mat = new THREE.MeshStandardMaterial({map:tex});
  const plate = new THREE.Mesh(new THREE.PlaneGeometry(0.7,0.28), mat);
  const stand = new THREE.Mesh(new THREE.BoxGeometry(0.7,0.04,0.16), new THREE.MeshStandardMaterial({color:0x1a1510}));
  const group = new THREE.Group();
  plate.position.set(0,0.16,0.02);
  plate.rotation.x = -0.35;
  group.add(plate, stand);
  return group;
}

function makePedestal(radius=0.42){
