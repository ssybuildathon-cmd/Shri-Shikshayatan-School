",
};
</script>
<script>
/* =========================================================================
   ESCAPE: THE HOLLOW GALLERY — single-room 3D psychological horror escape
   Built with vanilla Three.js (r128), custom pointer-lock mouselook.
   ========================================================================= */

//// ---------- GLOBAL GAME STATE ----------
const GameState = {
  skipCount: 0,
  maxSkips: 6,
  lives: 5,
  lightsCut: false,
  fragments: [],   // collected fragment names
  tools: [],        // collected tool names
  lore: [],         // collected lore snippets
  composureBoosts: 0,
  stationsSolved: {}, // name -> true
  vaultCode: [],    // required order for the vault
  ended: false,
  glitchActive: false,
  pointerLocked: false
};

const clockTimes = ["5:00 PM","5:10 PM","5:20 PM","5:30 PM","5:40 PM","5:50 PM","6:00 PM"];

function logMsg(text, danger=false){
  const log = document.getElementById('msgLog');
  const div = document.createElement('div');
  div.textContent = "» " + text;
  if(danger) div.style.color = "#d16a5a";
  log.prepend(div);
  while(log.children.length > 6){ log.removeChild(log.lastChild); }
}

let itemToastTimer=null;
function showItemToast(name){
  const el = document.getElementById('itemToast');
  document.getElementById('itemToastName').textContent = name;
  el.classList.add('show');
  clearTimeout(itemToastTimer);
  itemToastTimer = setTimeout(()=> el.classList.remove('show'), 2600);
  playCollectSound();
}
function playCollectSound(){
  if(!museumAudio) return;
  const ac = museumAudio.ac;
  const osc = ac.createOscillator(); const g = ac.createGain();
  osc.type='sine'; osc.frequency.setValueAtTime(520, ac.currentTime);
  osc.frequency.exponentialRampToValueAtTime(920, ac.currentTime+0.18);
  g.gain.setValueAtTime(0.0001, ac.currentTime);
  g.gain.exponentialRampToValueAtTime(0.11, ac.currentTime+0.02);
  g.gain.exponentialRampToValueAtTime(0.0001, ac.currentTime+0.5);
  osc.connect(g).connect(museumAudio.master);
  osc.start(); osc.stop(ac.currentTime+0.55);
}
function collectTool(name){
  GameState.tools.push(name);
  showItemToast(name);
}
function collectFragment(name){
  GameState.fragments.push(name);
  showItemToast(name);
}

function updateHUD(){
  document.getElementById('clockDisplay').textContent = clockTimes[GameState.skipCount];
  let dots = "";
  for(let i=0;i<GameState.maxSkips;i++){
    dots += (i < GameState.skipCount) ? "● " : "○ ";
  }
  document.getElementById('skipDots').textContent = dots.trim();

  const invEl = document.getElementById('invList');
  const items = [...GameState.fragments.map(f=>"◆ "+f), ...GameState.tools.map(t=>"⚙ "+t)];
  invEl.innerHTML = items.length ? items.map(i=>`<div>${i}</div>`).join("") : '<span class="empty">nothing yet...</span>';

  document.getElementById('livesRow').textContent = "♥ ".repeat(GameState.lives).trim() + " " + "♡ ".repeat(5-GameState.lives).trim();

  document.getElementById('vignette').classList.toggle('danger', GameState.lightsCut);
  updateObjective();
}

//// ---------- PUZZLE CHAIN: each solve rewards the key to the next lock ----------
// Order the player is meant to move through the room. Every station (other than
// the first) stays locked until the player is holding the key named in KEY_REQUIRED.
const PUZZLE_ORDER = ["Display Cabinet","Grandfather Clock","Number Lock","Curator's Desk","The Vault"];
const KEY_REQUIRED = {
  "Display Cabinet": null,               // always open — the starting puzzle
  "Grandfather Clock": "UV Flashlight",  // earned from the Display Cabinet
  "Number Lock": "Vault Map Fragment",   // earned from the Grandfather Clock
  "Curator's Desk": "Dial Key",          // earned from the Number Lock
  "The Vault": "Brass Key",              // earned from the Curator's Desk
  "The Portrait": "Dial Key"             // optional detour — opens once you reach the Number Lock's key
};
function hasKey(name){
  return GameState.tools.includes(name) || GameState.fragments.includes(name);
}
function stationLocked(stationName){
  const need = KEY_REQUIRED[stationName];
  if(!need) return false;
  return !hasKey(need);
}
function lockedMessage(stationName){
  const need = KEY_REQUIRED[stationName];
  return `This is locked tight. It won't budge without the <b>${need}</b> — you'll find that by solving what comes before it.`;
}

// Tells a first-time player exactly what to do next, in plain language.
function updateObjective(){
  const el = document.getElementById('objectiveText');
  if(!el) return;
  const solved = GameState.stationsSolved;

  let text = "";
  if(!solved["Display Cabinet"]){
    text = "Start at the <b>Display Cabinet</b> — work out which gems are genuine, in order, to earn the UV Flashlight.";
  } else if(!solved["Grandfather Clock"]){
    text = "Use the UV Flashlight's light at the <b>Grandfather Clock</b> — work out the hour and minute the clues give.";
  } else if(!solved["Number Lock"]){
    text = "Head to the <b>Numbered Dial Lock</b> (the suit of armor) — arrange its dials into the right order.";
  } else if(!solved["Curator's Desk"]){
    text = "Return to the <b>Curator's Desk</b> — the burned letter names the seal that fits.";
  } else if(!solved["The Vault"]){
    text = "You hold the Brass Key. Head to <b>The Vault</b> (back wall) and open it.";
  } else {
    text = "The vault is open. Step through to finish.";
  }
  const keyItems = ["UV Flashlight","Vault Map Fragment","Dial Key","Brass Key"];
  const keyCount = keyItems.filter(k=>hasKey(k)).length;
  el.innerHTML = text + `<br><span style="color:#8a7345;font-size:11px;">Keys: ${keyCount}/4 · Composure: ${GameState.lives}/5</span>`;
}

function doTimeSkip(reason){
  if(GameState.ended) return;
  GameState.skipCount++;
  logMsg("The clock lurches forward — " + reason);
  updateHUD();
  // sync 3D clock hands
  updateClockHands();
  if(GameState.skipCount >= GameState.maxSkips){
    setTimeout(()=> endGame(false, "sealed"), 900);
  }
}

function loseLife(){
  GameState.lives--;
  updateHUD();
  if(GameState.lives <= 4 && !GameState.lightsCut){
    GameState.lightsCut = true;
    cutLights();
    logMsg("The lights die. Something is closer now.", true);
  }
  if(GameState.lives <= 0){
    setTimeout(()=> endGame(false, "caught"), 500);
  }
}

//// ---------- END GAME ----------
// ---- Final time-hole / reality-shift: after the vault, a burst of distortion
// suggests the whole visit was inside a pocket of skipped time, then the
// player is dropped back into the calm, ordinary museum before the credits. ----
function playRealityShift(callback){
  document.getElementById('gameCanvas').classList.add('shakeScreen');
  const flash = document.getElementById('introGlitchOverlay');
  flash.classList.add('colorGlitch');
  introNoise(1.0, 0.12);
  let flickers = 0;
  const id = setInterval(()=>{
    flash.style.opacity = (flickers % 2 === 0) ? (0.35+Math.random()*0.5) : '0';
    if(flickers % 3 === 0) introTone(70+Math.random()*300, 0.12, 'sawtooth', 0.03);
    flickers++;
    if(flickers > 13){
      clearInterval(id);
      document.getElementById('gameCanvas').classList.remove('shakeScreen');
      flash.style.opacity = '1';
      setTimeout(()=>{
        flash.classList.remove('colorGlitch');
        flash.style.opacity = '0';
        playBlinkTransition(()=>{
          document.getElementById('blinkTop').style.height='0%';
          document.getElementById('blinkBottom').style.height='0%';
          const rs = document.getElementById('realityShiftScene');
          rs.style.display = 'block';
          const ann = document.getElementById('rsAnnouncement');
          setTimeout(()=>{
            ann.textContent = "\u201cWelcome to the museum.\u201d";
            ann.classList.add('show');
            introTone(660,0.5,'sine',0.05,0);
            introTone(880,0.6,'sine',0.04,0.28);
          }, 700);
          setTimeout(()=>{
            rs.style.display = 'none';
            ann.classList.remove('show');
            callback();
          }, 3400);
        });
      }, 300);
    }
  }, 110);
}

function endGame(won, mode){
  GameState.ended = true;
  exitPointerLock();
  if(won){ playRealityShift(()=> showEndScreen(won, mode)); }
  else{ showEndScreen(won, mode); }
}

function showEndScreen(won, mode){
  const screen = document.getElementById('endScreen');
  const title = document.getElementById('endTitle');
  const text = document.getElementById('endText');
  screen.style.display = "flex";

  if(won){
    const full = GameState.lore.length >= 3 && GameState.lives >= 4;
    if(full){
      title.textContent = "THE TRUTH ESCAPES WITH YOU";
      text.textContent = "The vault door groans open into cool night air. Behind you, for the first time in decades, the portrait's eyes finally close. You carry the whole story out with you.";
    } else {
      title.textContent = "JUST MADE IT";
      text.textContent = "The door opens before 6:00. You don't look back to check if it really let you go, or if you simply got lucky.";
    }
  } else if(mode === "sealed"){
    title.textContent = "SEALED IN";
    text.textContent = "The grandfather clock chimes six times. The vault never opens. Somewhere, a new plaque is already being engraved.";
  } else {
    title.textContent = "CAUGHT FOR GOOD";
    text.textContent = "The dark finally catches up to you. The last sound you hear is the vault sealing itself — from the outside.";
  }
}

document.getElementById('restartBtn').onclick = ()=> location.reload();

//// ---------- THREE.JS SETUP ----------
let scene, camera, renderer, raycaster;
let moveState = {f:false,b:false,l:false,r:false};
let yaw=0, pitch=0;
const playerPos = new THREE.Vector3(0, 1.6, 7.5);
const ROOM_HALF_X = 15.2;   // wide hall, east-west
const ROOM_HALF_Z = 10.2;   // north-south
const ROOM_HALF = ROOM_HALF_X; // kept for any legacy reference
const ROOM_W = ROOM_HALF_X*2, ROOM_D = ROOM_HALF_Z*2, ROOM_H = 7.6;

const canvas = document.getElementById('gameCanvas');
renderer = new THREE.WebGLRenderer({canvas, antialias:true});
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(Math.min(window.devicePixelRatio,2));
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
renderer.outputColorSpace = THREE.SRGBColorSpace;
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 1.0; // restore the original wall readability under ACES mapping
renderer.physicallyCorrectLights = true;
renderer.info.autoReset = false;
// Optional developer quality switch; HIGH is the normal default and gameplay-independent.
const GALLERY_QUALITY = window.GALLERY_QUALITY || 'HIGH';
if(GALLERY_QUALITY === 'LOW') renderer.setPixelRatio(1);
else if(GALLERY_QUALITY === 'MEDIUM') renderer.setPixelRatio(Math.min(window.devicePixelRatio,1.35));

scene = new THREE.Scene();
scene.background = new THREE.Color(0x030201);
scene.fog = new THREE.FogExp2(0x0a0703, 0.019);

camera = new THREE.PerspectiveCamera(72, window.innerWidth/window.innerHeight, 0.1, 200);
camera.position.copy(playerPos);

//// ---------- REAL-WORLD ENVIRONMENT LIGHTING (Museum of Ethnography HDRI) ----------
// Uses the supplied HDRI panorama as image-based lighting so gold/brass/glass
// surfaces pick up believable reflections of an actual museum interior,
// instead of flat ambient-only shading.
(function setupEnvironment(){
  const pmrem = new THREE.PMREMGenerator(renderer);
  pmrem.compileEquirectangularShader();
  const envLoader = new THREE.TextureLoader();
  envLoader.load(REAL_ASSETS.envPano, function(tex){
    tex.mapping = THREE.EquirectangularReflectionMapping;
    tex.colorSpace = THREE.SRGBColorSpace;
    const envRT = pmrem.fromEquirectangular(tex);
    scene.environment = envRT.texture;
    tex.dispose();
    pmrem.dispose();
  });
})();

raycaster = new THREE.Raycaster();

window.addEventListener('resize', ()=>{
  camera.aspect = window.innerWidth/window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
});

//// ---------- LIGHTING ----------
// Only the central chandelier remains as a real light source, plus a very
// low ambient fill so unlit corners aren't pure black.
let ambient;
const chandelierLights = []; // populated in buildRoom(), used below for dim/flicker
const cinematicLights = [];
function addMuseumSpot(color, intensity, distance, angle, penumbra, position, targetPosition){
  const light = new THREE.SpotLight(color, intensity, distance, angle, penumbra, 2);
  light.position.set(...position);
  light.target.position.set(...targetPosition);
  light.castShadow = true;
  light.shadow.mapSize.set(1024, 1024);
  light.shadow.radius = 4;
  light.shadow.bias = -0.0003;
  scene.add(light, light.target);
  cinematicLights.push({light, base:intensity, phase:position[0]*0.17 + position[2]*0.11});
  return light;
}
function buildLights(){
  ambient = new THREE.AmbientLight(0x4a4130, 0.28); // original gallery fill
  scene.add(ambient);
  const hemi = new THREE.HemisphereLight(0x6d7c92, 0x160d07, 0.16);
  scene.add(hemi);
  // Deliberate exhibit pools; positions match existing exhibits and never affect routing.
  addMuseumSpot(0xffd39a, 1.2, 12, Math.PI/5, 0.72, [-11,6.8,-8], [-11,0,-8]);
  addMuseumSpot(0xffc77c, 1.0, 12, Math.PI/5, 0.72, [11,6.8,-8.6], [11,0,-8.6]);
  addMuseumSpot(0xd6e0ff, 0.85, 11, Math.PI/5, 0.78, [-13.6,6.8,3.5], [-13.6,1,3.5]);
  addMuseumSpot(0xffc98d, 0.9, 10, Math.PI/5, 0.78, [13.6,6.8,2], [13.6,1,2]);
  addMuseumSpot(0xc5d5ff, 0.7, 10, Math.PI/5, 0.8, [0,6.7,-9.8], [0,1,-9.8]);
  addMuseumSpot(0xffb36b, 0.75, 9, Math.PI/5, 0.8, [-2.2,6.5,-9.5], [-2.2,1.5,-9.5]);
}
function updateCinematicLighting(t){
  cinematicLights.forEach(({light,base,phase})=>{
    const whisper = 1 + Math.sin(t*0.00115 + phase)*0.025 + Math.sin(t*0.0037 + phase*2)*0.012;
    light.intensity = base * whisper * (GameState.lightsCut ? 0.12 : 1);
  });
}
buildLights();

function cutLights(){
  ambient.intensity = 0.06;
  chandelierLights.forEach(cl => cl.intensity = 0.15);
}

// subtle flicker on the chandelier bulbs for atmosphere (kept gentle so the
// room stays readable)
setInterval(()=>{
  if(GameState.lightsCut) return;
  chandelierLights.forEach(cl => cl.intensity = 1.0 + Math.random()*0.3);
}, 700);

//// ---------- ROOM GEOMETRY (wide realistic museum hall) ----------
// Procedural marble texture (canvas) so the floor reads as real polished stone
// rather than a flat color.
function makeMarbleTexture(base, vein, size=512){
  const cv = document.createElement('canvas'); cv.width=cv.height=size;
  const ctx = cv.getContext('2d');
  ctx.fillStyle = base; ctx.fillRect(0,0,size,size);
  ctx.globalAlpha = 0.5;
  for(let i=0;i<26;i++){
    ctx.strokeStyle = vein;
    ctx.lineWidth = Math.random()*1.6+0.4;
    ctx.beginPath();
    let x = Math.random()*size, y=0;
    ctx.moveTo(x,y);
    for(let j=0;j<8;j++){
      x += (Math.random()-0.5)*90;
      y += size/8;
      ctx.lineTo(x,y);
    }
    ctx.stroke();
  }
  ctx.globalAlpha = 1;
  const tex = new THREE.CanvasTexture(cv);
  tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
  return tex;
}
// Wood parquet-ish tile pattern for variety on the floor border
function makeTileTexture(){
  const cv = document.createElement('canvas'); cv.width=cv.height=256;
  const ctx = cv.getContext('2d');
  ctx.fillStyle = "#2c2415"; ctx.fillRect(0,0,256,256);
  ctx.strokeStyle = "#4a3d22"; ctx.lineWidth = 3;
  for(let i=0;i<=256;i+=64){ ctx.beginPath(); ctx.moveTo(i,0); ctx.lineTo(i,256); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(0,i); ctx.lineTo(256,i); ctx.stroke(); }
  const tex = new THREE.CanvasTexture(cv);
  tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
  return tex;
}

// Wood-plank floor texture, ported from exhibit-1700.html
function makeWoodFloorTexture(repX, repY){
  const w=256, h=256;
  const cv = document.createElement('canvas'); cv.width=w; cv.height=h;
  const ctx = cv.getContext('2d');
  ctx.fillStyle = '#241a10'; ctx.fillRect(0,0,w,h);
  const planks = 8;
  for(let i=0;i<planks;i++){
    const py = i*(h/planks);
    const shade = 22 + Math.floor(Math.random()*10);
    ctx.fillStyle = 'rgb('+(shade+18)+','+(shade+10)+','+shade+')';
    ctx.fillRect(0,py,w,h/planks-2);
    ctx.strokeStyle='rgba(0,0,0,0.5)'; ctx.lineWidth=2;
    ctx.strokeRect(0,py,w,h/planks-2);
    for(let g=0; g<14; g++){
      ctx.strokeStyle='rgba(0,0,0,'+(0.05+Math.random()*0.08)+')';
      ctx.beginPath();
      const gy = py+2+Math.random()*(h/planks-6);
      ctx.moveTo(0,gy); ctx.lineTo(w,gy+(Math.random()*6-3));
      ctx.stroke();
    }
  }
  const tex = new THREE.CanvasTexture(cv);
  tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
  tex.repeat.set(repX, repY);
  tex.anisotropy = 4;
  return tex;
}

// Wood-panel wall texture, ported from exhibit-1700.html
function makeWoodWallTexture(repX, repY){
  const w=256, h=256;
  const cv = document.createElement('canvas'); cv.width=w; cv.height=h;
  const ctx = cv.getContext('2d');
  ctx.fillStyle = '#1c130c'; ctx.fillRect(0,0,w,h);
  ctx.fillStyle = 'rgba(70,50,28,0.5)';
  for(let x=0;x<w;x+=64){
    ctx.beginPath();
    ctx.moveTo(x+32,0);
    ctx.bezierCurveTo(x+10,h*0.3, x+54,h*0.6, x+32,h);
    ctx.lineTo(x+32,h); ctx.stroke();
  }
  ctx.strokeStyle='rgba(90,65,35,0.35)'; ctx.lineWidth=3;
  for(let xx=0; xx<w; xx+=64){ ctx.strokeRect(xx+6,6,52,h-12); }
  ctx.fillStyle='rgba(0,0,0,0.25)';
  ctx.fillRect(0,h-40,w,40);
  const tex = new THREE.CanvasTexture(cv);
  tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
  tex.repeat.set(repX, repY);
  tex.anisotropy = 4;
  return tex;
}

// PBR museum glass: environment response, Fresnel-like clearcoat, thickness and low roughness.
// MeshPhysicalMaterial is available in the bundled Three.js build; fallback keeps compatibility.
function museumGlassMaterial(opacity=.18){
  const Glass = THREE.MeshPhysicalMaterial || THREE.MeshStandardMaterial;
  return new Glass({color:0x9fc6d0, metalness:0.02, roughness:0.09, transparent:true,
    opacity, transmission:0.42, thickness:0.045, ior:1.46, envMapIntensity:0.72,
    clearcoat:0.38, clearcoatRoughness:0.12, side:THREE.DoubleSide, depthWrite:false});
}
function varyRoughness(material, base, spread=.08){ material.roughness=base + (Math.random()-.5)*spread; return material; }

function buildRoom(){
  const woodFloorTex = makeWoodFloorTexture(ROOM_W*0.4, ROOM_D*0.4);
  const floorMat = new THREE.MeshStandardMaterial({map:woodFloorTex, roughness:0.82, metalness:0.05});

  const tileTex = makeTileTexture();
  tileTex.repeat.set(ROOM_W/2.2, ROOM_D/2.2);
  const borderMat = new THREE.MeshStandardMaterial({map:tileTex, roughness:0.8});

  const wallMatNS = new THREE.MeshStandardMaterial({map:makeWoodWallTexture(ROOM_W*0.4, 2.6), roughness:0.9});
  const wallMatEW = new THREE.MeshStandardMaterial({map:makeWoodWallTexture(ROOM_D*0.4, 2.6), roughness:0.9});
  const wainscotMat = new THREE.MeshStandardMaterial({color:0x1e1a12, roughness:0.6});
  const ceilMat = new THREE.MeshStandardMaterial({color:0x171310, roughness:1});
  const goldTrimMat = new THREE.MeshStandardMaterial({color:0xc9a24a, metalness:0.8, roughness:0.2});

  // border walkway (parquet) under the main marble field, for realism/contrast
  const border = new THREE.Mesh(new THREE.PlaneGeometry(ROOM_W, ROOM_D), borderMat);
  border.rotation.x = -Math.PI/2; border.position.y = -0.01;
  scene.add(border);

  const floor = new THREE.Mesh(new THREE.PlaneGeometry(ROOM_W-3, ROOM_D-3), floorMat);
  floor.rotation.x = -Math.PI/2;
  floor.receiveShadow = true;
  scene.add(floor);

  const ceil = new THREE.Mesh(new THREE.PlaneGeometry(ROOM_W, ROOM_D), ceilMat);
  ceil.rotation.x = Math.PI/2;
  ceil.position.y = ROOM_H;
  scene.add(ceil);

  // Add ornate gold ceiling trim
  const ceilingTrim = new THREE.Mesh(new THREE.BoxGeometry(ROOM_W, 0.15, ROOM_D), goldTrimMat);
  ceilingTrim.position.y = ROOM_H - 0.075;
  scene.add(ceilingTrim);

  // long north/south walls (wide) and shorter east/west walls
  const wallNS = new THREE.PlaneGeometry(ROOM_W, ROOM_H);
  const wallEW = new THREE.PlaneGeometry(ROOM_D, ROOM_H);
  const positions = [
    {geo:wallNS, pos:[0,ROOM_H/2,-ROOM_HALF_Z], rot:[0,0,0]},
    {geo:wallNS, pos:[0,ROOM_H/2, ROOM_HALF_Z], rot:[0,Math.PI,0]},
    {geo:wallEW, pos:[-ROOM_HALF_X,ROOM_H/2,0], rot:[0,Math.PI/2,0]},
    {geo:wallEW, pos:[ ROOM_HALF_X,ROOM_H/2,0], rot:[0,-Math.PI/2,0]},
  ];
  positions.forEach(p=>{
    const isNSWall = (p.pos[2] !== 0);
    const wall = new THREE.Mesh(p.geo, isNSWall ? wallMatNS : wallMatEW);
    wall.position.set(...p.pos);
    wall.rotation.set(...p.rot);
    wall.receiveShadow = true;
    scene.add(wall);
    // wainscoting strip along the base of each wall
    const isNS = (p.pos[2] !== 0);
    const wain = new THREE.Mesh(isNS ? new THREE.PlaneGeometry(ROOM_W,1.1) : new THREE.PlaneGeometry(ROOM_D,1.1), wainscotMat);
    const nudge = 0.015;
    wain.position.set(
      p.pos[0] + (isNS ? 0 : Math.sign(p.pos[0])*nudge),
      0.55,
      p.pos[2] + (isNS ? Math.sign(p.pos[2])*nudge : 0)
    );
    wain.rotation.set(...p.rot);
    scene.add(wain);
  });

  // Add gold trim strips along top of walls (architectural detail)
  positions.forEach(p=>{
    const isNS = (p.pos[2] !== 0);
    const goldTrim = new THREE.Mesh(isNS ? new THREE.PlaneGeometry(ROOM_W,0.25) : new THREE.PlaneGeometry(ROOM_D,0.25), goldTrimMat);
    const trimPos = ROOM_H - 0.2;
    goldTrim.position.set(p.pos[0], trimPos, p.pos[2]);
    goldTrim.rotation.set(...p.rot);
    scene.add(goldTrim);
  });

  // Marble columns lining the long walls, spaced along the hall for grandeur
  const colMat = new THREE.MeshStandardMaterial({color:0xcabf9e, roughness:0.4});
  const colXs = [-11, -3.5, 3.5, 11];
  colXs.forEach(x=>{
    [ -ROOM_HALF_Z+0.4, ROOM_HALF_Z-0.4 ].forEach(z=>{
      const col = new THREE.Group();
      const shaft = new THREE.Mesh(new THREE.CylinderGeometry(0.34,0.4,ROOM_H-0.6,16), colMat);
      shaft.position.y = (ROOM_H-0.6)/2 + 0.3;
      shaft.castShadow = true;
      const base = new THREE.Mesh(new THREE.CylinderGeometry(0.52,0.52,0.3,16), colMat);
      base.position.y = 0.15;
      const cap = new THREE.Mesh(new THREE.CylinderGeometry(0.48,0.36,0.32,16), colMat);
      cap.position.y = ROOM_H-0.45;
      col.add(shaft, base, cap);
      col.position.set(x, 0, z);
      scene.add(col);
      
      // Add gold capital accent
      const capGold = new THREE.Mesh(new THREE.CylinderGeometry(0.5,0.5,0.08,16), goldTrimMat);
      capGold.position.set(x, ROOM_H - 0.25, z);
      scene.add(capGold);
    });
  });

  // Central chandelier for warm realistic top light + focal point
  const chGroup = new THREE.Group();
  const chRing = new THREE.Mesh(new THREE.TorusGeometry(1.2,0.08,10,32), goldTrimMat);
  chRing.position.y = ROOM_H-1.4;
  const chChain = new THREE.Mesh(new THREE.CylinderGeometry(0.03,0.03,1.5,8), new THREE.MeshStandardMaterial({color:0x3a2a1a, metalness:0.6}));
  chChain.position.y = ROOM_H-0.65;
  chGroup.add(chRing, chChain);
  
  // Main chandelier lights - expanded, now the room's primary light source
  for(let i=0;i<8;i++){
    const a = (i/8)*Math.PI*2;
    const bulb = new THREE.Mesh(new THREE.SphereGeometry(0.08,8,8), new THREE.MeshStandardMaterial({color:0x3a2f10, emissive:0xffe0a8, emissiveIntensity:1.2}));
    bulb.position.set(Math.cos(a)*1.1, ROOM_H-1.4, Math.sin(a)*1.1);
    chGroup.add(bulb);
    // Add point light for each bulb
    const light = new THREE.PointLight(0xffcf8a, 1.15, 13, 2);
    light.position.copy(bulb.position);
    if(i===0){
      light.castShadow = true;
      light.shadow.mapSize.set(1024,1024);
    }
    chGroup.add(light);
    chandelierLights.push(light);
  }
  // Center ornamental piece
  const ornament = new THREE.Mesh(new THREE.SphereGeometry(0.15,8,8), goldTrimMat);
  ornament.position.y = ROOM_H - 1.6;
  chGroup.add(ornament);
  
  scene.add(chGroup);

  // A long decorative rug down the center aisle — carpet texture (dark red
  // runner, gold border and medallions) ported from exhibit-1700.html
  const carpetTex = (()=>{
    const w=128, h=256;
    const cv = document.createElement('canvas'); cv.width=w; cv.height=h;
    const ctx = cv.getContext('2d');
    ctx.fillStyle = '#5c1414'; ctx.fillRect(0,0,w,h);
    ctx.strokeStyle = '#caa24a'; ctx.lineWidth = 6;
    ctx.strokeRect(10,10,w-20,h-20);
    ctx.fillStyle = 'rgba(202,162,74,0.5)';
    for(let i=0;i<6;i++){ ctx.beginPath(); ctx.arc(w/2, (i+0.5)*(h/6), 10, 0, Math.PI*2); ctx.fill(); }
    const tex = new THREE.CanvasTexture(cv);
    tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
    tex.repeat.set(1, ROOM_D/3.2);
    tex.anisotropy = 4;
    return tex;
  })();
  const rug = new THREE.Mesh(new THREE.PlaneGeometry(3.4, ROOM_D-4), new THREE.MeshStandardMaterial({map:carpetTex, roughness:0.95}));
  rug.rotation.x = -Math.PI/2; rug.position.y = 0.01;
  rug.receiveShadow = true;
  scene.add(rug);
}
buildRoom();

//// ---------- DECORATIVE ANTIQUES (non-interactive museum dressing) ----------
function buildDecor(){
  const marble = new THREE.MeshStandardMaterial({color:0xd8cfb0, roughness:0.35});
  const bronze = new THREE.MeshStandardMaterial({color:0x8a6a35, metalness:0.75, roughness:0.3});
  const wood   = new THREE.MeshStandardMaterial({color:0x3a2a18, roughness:0.6});

  // Classical statues flanking the entrance rug
  function makeStatue(){
    const g = new THREE.Group();
    const plinth = new THREE.Mesh(new THREE.BoxGeometry(0.7,0.5,0.7), marble);
    plinth.position.y = 0.25;
