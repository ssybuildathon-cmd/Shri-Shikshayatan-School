    head.position.y = 1.95;
    g.add(plinth, torso, head);
    return g;
  }
  const statueL = makeStatue(); statueL.position.set(-4.2, 0, 9.3);
  const statueR = makeStatue(); statueR.position.set(4.2, 0, 9.3);
  scene.add(statueL, statueR);

  // Large bronze urn near the mummy alcove
  const urn = new THREE.Mesh(new THREE.CylinderGeometry(0.35,0.22,0.9,14), bronze);
  urn.position.set(-8.6, 0.45, 8.8);
  scene.add(urn);

  // Low glass bookshelf case near the desk, for museum-archive flavor
  const shelfGroup = new THREE.Group();
  const shelfBody = new THREE.Mesh(new THREE.BoxGeometry(1.4,1.1,0.5), wood);
  shelfBody.position.y = 0.55;
  const shelfGlass = new THREE.Mesh(new THREE.PlaneGeometry(1.2,0.9), museumGlassMaterial(.16));
  shelfGlass.position.set(0,0.55,0.26);
  shelfGroup.add(shelfBody, shelfGlass);
  shelfGroup.position.set(-11, 0, -3.5);
  scene.add(shelfGroup);

  // Extra framed paintings along the long side walls for gallery density.
  // Each is a real canvas texture with a distinct subject, not a solid-color block.
  function makePaintingTexture(style, w=320, h=420){
    const cv = document.createElement('canvas'); cv.width=w; cv.height=h;
    const c = cv.getContext('2d');
    const rnd = (n=1)=>Math.random()*n;
    const stroke = (color, width, x1,y1,x2,y2)=>{ c.strokeStyle=color; c.lineWidth=width; c.beginPath(); c.moveTo(x1,y1); c.lineTo(x2,y2); c.stroke(); };
    const grad = c.createLinearGradient(0,0,0,h);
    const palettes = {
      architecture:['#17151b','#443c36','#8c7658'], landscape:['#111b20','#263b32','#766442'], portrait:['#1a1316','#49302b','#b18b66'], abstract:['#171522','#3a2747','#a36c57'], corridor:['#10151a','#39434a','#aa805b']
    };
    const pal = palettes[style] || palettes.architecture;
    grad.addColorStop(0,pal[0]); grad.addColorStop(.58,pal[1]); grad.addColorStop(1,pal[2]);
    c.fillStyle=grad; c.fillRect(0,0,w,h);
    c.globalAlpha=.18;
    for(let i=0;i<95;i++) stroke(i%2?'#ead5a2':'#050507', 1+rnd(4), rnd(w),rnd(h),rnd(w),rnd(h));
    c.globalAlpha=1;
    if(style==='architecture'){
      c.fillStyle='#0b0b10'; c.fillRect(0,h*.68,w,h*.32);
      c.fillStyle='#6e5b46'; c.beginPath(); c.moveTo(30,h*.68); c.lineTo(95,h*.27); c.lineTo(205,h*.27); c.lineTo(290,h*.68); c.closePath(); c.fill();
      c.fillStyle='#17131a'; c.fillRect(120,h*.42,80,h*.26);
      for(let i=0;i<5;i++) c.fillRect(52+i*52,h*.51,13,h*.17);
      stroke('#d6b878',4,0,h*.69,w,h*.69);
      for(let i=0;i<8;i++) stroke('rgba(218,184,117,.5)',2,20+i*40,h*.69,70+i*35,h*.92);
    } else if(style==='landscape'){
      c.fillStyle='#0b151a'; c.beginPath(); c.moveTo(0,h*.62); c.lineTo(70,h*.38); c.lineTo(140,h*.58); c.lineTo(220,h*.32); c.lineTo(w,h*.62); c.lineTo(w,h); c.lineTo(0,h); c.fill();
      c.fillStyle='#6c7251'; c.beginPath(); c.moveTo(0,h*.78); c.quadraticCurveTo(100,h*.61,180,h*.78); c.quadraticCurveTo(260,h*.62,w,h*.75); c.lineTo(w,h); c.lineTo(0,h); c.fill();
      c.fillStyle='#b89b65'; c.beginPath(); c.arc(w*.72,h*.22,25,0,Math.PI*2); c.fill();
      for(let i=0;i<18;i++) stroke('rgba(205,173,106,.55)',2, rnd(w),h*.82+rnd(35),rnd(w),h*.58+rnd(40));
    } else if(style==='portrait'){
      c.fillStyle='#0b090c'; c.beginPath(); c.ellipse(w*.5,h*.52,72,122,0,0,Math.PI*2); c.fill();
      c.fillStyle='#9e775f'; c.beginPath(); c.ellipse(w*.5,h*.31,43,53,0,0,Math.PI*2); c.fill();
      c.fillStyle='#120e12'; c.fillRect(w*.43,h*.30,12,5); c.fillRect(w*.57,h*.30,12,5);
      c.fillStyle='#c9a879'; c.beginPath(); c.arc(w*.45,h*.32,4,0,Math.PI*2); c.arc(w*.55,h*.32,4,0,Math.PI*2); c.fill();
      c.fillStyle='#30202a'; c.beginPath(); c.moveTo(w*.28,h); c.quadraticCurveTo(w*.5,h*.55,w*.72,h); c.fill();
      stroke('#d2b17b',3,w*.47,h*.38,w*.53,h*.38); stroke('#6f3940',5,w*.46,h*.48,w*.54,h*.48);
    } else if(style==='abstract'){
      for(let i=0;i<20;i++){ c.fillStyle=['#7c3944','#c38b5a','#354e5c','#b6a26c'][i%4]; c.globalAlpha=.45; c.beginPath(); c.ellipse(rnd(w),rnd(h),20+rnd(65),10+rnd(50),rnd(6),0,Math.PI*2); c.fill(); }
      c.globalAlpha=1; stroke('#d7bd82',9,30,h*.22,w-40,h*.77); stroke('#291c38',22,w*.18,h*.85,w*.82,h*.15);
      c.fillStyle='#0b0910'; c.beginPath(); c.arc(w*.52,h*.48,24,0,Math.PI*2); c.fill();
    } else {
      c.fillStyle='#0b0d11'; c.fillRect(w*.18,h*.18,w*.64,h*.7);
      for(let i=0;i<5;i++){ c.fillStyle=i%2?'#6c5545':'#35404a'; c.fillRect(w*(.23+i*.12),h*.22,w*.055,h*.66); }
      c.fillStyle='#c19b69'; c.fillRect(w*.46,h*.2,w*.08,h*.68); c.fillStyle='#07080b'; c.fillRect(w*.43,h*.66,w*.14,h*.22);
      stroke('#c8a66e',4,w*.18,h*.18,w*.82,h*.18); stroke('#c8a66e',3,w*.18,h*.88,w*.82,h*.88);
    }
    // restrained varnish/canvas grain; the artwork remains visibly brush-painted
    c.globalAlpha=.1;
    for(let i=0;i<600;i++){ c.fillStyle=i%2?'#fff':'#000'; c.fillRect(rnd(w),rnd(h),1+rnd(2),1+rnd(2)); }
    c.globalAlpha=1;
    const tex = new THREE.CanvasTexture(cv); tex.colorSpace = THREE.SRGBColorSpace; tex.anisotropy=4;
    return tex;
  }
  function makePainting(w,h,color,style){
    const g = new THREE.Group();
    const frameMat = new THREE.MeshStandardMaterial({color:0x5a3d20, metalness:0.35, roughness:0.48});
    const innerMat = new THREE.MeshStandardMaterial({color:0x2b1a10, metalness:0.15, roughness:0.7});
    const depth=.14, bevel=.09, artW=w-.24, artH=h-.24;
    const back = new THREE.Mesh(new THREE.BoxGeometry(w,h,.09), innerMat); back.position.z=-.08;
    const top = new THREE.Mesh(new THREE.BoxGeometry(w,bevel,depth), frameMat); top.position.set(0,h/2-bevel/2,.01);
    const bottom = top.clone(); bottom.position.y=-h/2+bevel/2;
    const left = new THREE.Mesh(new THREE.BoxGeometry(bevel,h-.12,depth), frameMat); left.position.set(-w/2+bevel/2,0,.01);
    const right = left.clone(); right.position.x=w/2-bevel/2;
    const artMat = new THREE.MeshStandardMaterial({map:makePaintingTexture(style), color:0xffffff, roughness:.92, metalness:0.0, bumpMap:makePaintingTexture('abstract',128,168), bumpScale:.018});
    const art = new THREE.Mesh(new THREE.PlaneGeometry(artW,artH), artMat); art.position.z=-.005;
    const inner = new THREE.Mesh(new THREE.BoxGeometry(artW+.035,artH+.035,.025), new THREE.MeshStandardMaterial({color:0x1b120b,roughness:.8})); inner.position.z=-.035;
    g.add(back,inner,art,top,bottom,left,right);
    return g;
  }
  const p1 = makePainting(1.1,1.4,0x3a3226,'architecture'); p1.position.set(-15.05,2.6,-4.5); p1.rotation.y = Math.PI/2;
  const p2 = makePainting(1.0,1.3,0x4a3020,'landscape'); p2.position.set(-15.05,2.6, 5); p2.rotation.y = Math.PI/2;
  const p3 = makePainting(1.1,1.4,0x30352e,'portrait'); p3.position.set(15.05,2.6,-4.5); p3.rotation.y = -Math.PI/2;
  const p4 = makePainting(1.0,1.3,0x2f2a3a,'abstract'); p4.position.set(15.05,2.6, 5); p4.rotation.y = -Math.PI/2;
  scene.add(p1,p2,p3,p4);
  [[p1,-15.05,2.6,-4.5],[p2,-15.05,2.6,5],[p3,15.05,2.6,-4.5],[p4,15.05,2.6,5]].forEach(([painting,x,y,z])=>{
    const lamp = new THREE.SpotLight(0xffd29a,0.36,4.5,Math.PI/6,.85,2);
    lamp.position.set(x + (x<0?1.2:-1.2), y+2.0, z); lamp.target=painting; lamp.castShadow=false; scene.add(lamp);
  });

  // A simple wooden viewing bench in the center aisle
  const bench = new THREE.Group();
  const seat = new THREE.Mesh(new THREE.BoxGeometry(1.6,0.1,0.5), wood);
  seat.position.y = 0.5;
  const legGeo = new THREE.BoxGeometry(0.08,0.5,0.08);
  [[-0.7,-0.18],[0.7,-0.18],[-0.7,0.18],[0.7,0.18]].forEach(([x,z])=>{
    const leg = new THREE.Mesh(legGeo, wood);
    leg.position.set(x,0.25,z);
    bench.add(leg);
  });
  bench.add(seat);
  bench.position.set(0, 0, 1.5);
  scene.add(bench);
}
buildDecor();

//// ---------- EXTRA AMBIENT DRESSING: more bookshelves + small exhibits ----------
// Purely decorative (non-interactive) props scattered around the hall to make
// it feel like a fuller museum, inspired by the reference photos: a bronze
// wrapped-mummy statue, a small standing sarcophagus, and an antique wall clock.
function buildExtraDecor(){
  const wood   = new THREE.MeshStandardMaterial({color:0x3a2a18, roughness:0.6});
  const bronze = new THREE.MeshStandardMaterial({color:0x8a6a35, metalness:0.8, roughness:0.3});
  const bronzeDark = new THREE.MeshStandardMaterial({color:0x5c4726, metalness:0.7, roughness:0.4});
