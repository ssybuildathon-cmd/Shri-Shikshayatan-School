  const shelfPositions = [
    [7, 0, -3.5, 0],       // mirrors the original bookshelf, east side
    [-6.5, 0, 4.2, 0.3],   // west-center, near the aisle
  ];
  shelfPositions.forEach(([x,y,z,rot])=>{
