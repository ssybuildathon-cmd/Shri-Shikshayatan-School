function updateClockHands(){
  // 5:00 -> 6:00 across 6 skips. minute hand full circle, hour hand small arc
  const progress = GameState.skipCount / 6; // 0..1
  const minuteAngle = progress * Math.PI * 2;
  const hourAngle = progress * (Math.PI * 2 / 12);
  minuteHand.rotation.z = -minuteAngle;
  hourHand.rotation.z = -hourAngle;
}

